# Rust
target/
target-*/
**/*.rs.bk
*.pdb

# Cargo
# Note: Cargo.lock IS tracked at the workspace root because we ship a binary
# (the `karoowa` CLI). Library-only crates would .gitignore it.

# Editor / IDE
.vscode/
.idea/
.fleet/
.zed/
*.swp
*.swo
*~
**/.DS_Store

# Env / secrets
.env
.env.local
.env.*.local
*.key
# Crash leftovers from karoowa_crypto::write_secret_file — these contain the
# secret and match neither *.key nor *.tmp.
.*.tmp[0-9]*.[0-9]*
*.pem
license.key
secrets/

# Build artifacts
*.log
*.tmp
dist/
out/
*.tar.gz
*.zip

# Local data
data/
.karoowa/

# Coverage / profiling
*.profraw
*.profdata
lcov.info
tarpaulin-report.html

# SBOM / release artifacts (generated)
*.spdx.json
*.cdx.json

# AI-tooling state (local only)
.claude/
.cursor/
.aider*

# Legacy / scratch (not part of the project)
files/
scratch/
bom.json
